<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp"
        android:paddingTop="32dp" android:paddingBottom="42dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="38dp" android:layout_height="38dp"
                android:src="@mipmap/ic_launcher" android:contentDescription="SnoreGuard logo"
                android:layout_marginEnd="10dp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="SNOREGUARD" android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.15" android:textColor="@color/primary" android:textSize="13sp" />
            <TextView android:id="@+id/versionText" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="12dp"
                android:text="v…" android:textColor="@color/text_secondary"
                android:textSize="12sp" android:fontFamily="sans-serif-medium" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Mirnija noć.\nPametniji alarm." android:layout_marginTop="8dp"
            android:textColor="@color/text_primary" android:textSize="30sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Telefon prepoznaje hrkanje, GT 2 prima obaveštenje. Bez snimanja i slanja zvuka."
            android:layout_marginTop="10dp" android:textColor="@color/text_secondary" android:textSize="14sp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:background="@drawable/bg_card" android:padding="20dp"
            android:orientation="vertical">
            <TextView android:id="@+id/statusLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="● Neaktivno" android:textColor="@color/primary" android:textSize="17sp"
                android:textStyle="bold" />
            <TextView android:id="@+id/liveDescription" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Pokreni kada kreneš na spavanje." android:layout_marginTop="8dp"
                android:textColor="@color/text_secondary" android:textSize="13sp" />
            <TextView android:id="@+id/liveConfidence" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="AI klasifikator: spreman nakon pokretanja" android:layout_marginTop="8dp"
                android:textColor="@color/text_secondary" android:textSize="12sp" />
            <Button android:id="@+id/startStopButton" android:layout_width="match_parent" android:layout_height="54dp"
                android:layout_marginTop="18dp" android:text="Pokreni noćno praćenje" android:textAllCaps="false"
                android:textColor="@color/button_text" android:textStyle="bold"
                android:background="@drawable/bg_primary" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="PODEŠAVANJA" android:letterSpacing="0.10"
            android:fontFamily="sans-serif-medium" android:textSize="12sp" android:textColor="@color/text_secondary" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="9dp" android:background="@drawable/bg_card" android:padding="18dp"
            android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Osetljivost AI detekcije" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="15sp" />
            <Spinner android:id="@+id/sensitivitySpinner" android:layout_width="match_parent"
                android:layout_height="48dp" android:layout_marginTop="4dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Prag utiče na lažne alarme. Nije medicinski kalibrisan."
                android:textSize="12sp" android:textColor="@color/text_secondary" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="Alarm     2 odvojena hrkaja u 15 sekundi" android:textColor="@color/text_secondary" android:textSize="14sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="7dp" android:text="AI analiza     na svakih 250 ms"
                android:textColor="@color/text_secondary" android:textSize="14sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="Režim alarma na satu"
                android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="15sp" />
            <Spinner android:id="@+id/alertModeSpinner" android:layout_width="match_parent"
                android:layout_height="48dp" android:layout_marginTop="4dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Sledeće upozorenje stiže nakon 16 s. Uslovi noćnog alarma ostaju isti."
                android:textSize="12sp" android:textColor="@color/text_secondary" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="7dp" android:text="Pauza između serija     60 sekundi" android:textColor="@color/text_secondary" android:textSize="14sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="7dp" android:text="Alarmi samo noću     22:00–08:00" android:textColor="@color/text_secondary" android:textSize="14sp" />
            <Switch android:id="@+id/phoneVibrationSwitch" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:text="Vibracija i na telefonu" android:textColor="@color/text_primary"
                android:textSize="14sp" android:checked="false" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Isključi ako želiš samo sat. Huawei Health može da odlučuje nezavisno od telefona."
                android:layout_marginTop="5dp" android:textSize="12sp" android:textColor="@color/text_secondary" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="VREME PRAĆENJA I SNIMANJE"
            android:letterSpacing="0.10" android:fontFamily="sans-serif-medium"
            android:textSize="12sp" android:textColor="@color/text_secondary" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="9dp" android:background="@drawable/bg_card" android:padding="18dp"
            android:orientation="vertical">
            <Button android:id="@+id/setStartTimeButton" android:layout_width="match_parent"
                android:layout_height="50dp" android:text="Početak: 22:00"
                android:textAllCaps="false" android:textColor="@color/text_primary"
                android:background="@drawable/bg_secondary" />
            <Button android:id="@+id/setEndTimeButton" android:layout_width="match_parent"
                android:layout_height="50dp" android:layout_marginTop="8dp"
                android:text="Kraj: 08:00" android:textAllCaps="false"
                android:textColor="@color/text_primary" android:background="@drawable/bg_secondary" />
            <TextView android:id="@+id/windowDescription" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="Izaberi raspored. Praćenje se pokreće ručno i zaustavlja na kraju intervala."
                android:textSize="12sp" android:textColor="@color/text_secondary" />
            <Switch android:id="@+id/saveClipsSwitch" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:text="Sačuvaj kratke snimke hrkanja"
                android:textSize="14sp" android:textColor="@color/text_primary" android:checked="false" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:textSize="12sp"
                android:text="Privatno, isključeno po defaultu. Samo potvrđeni događaji: do 10 WAV isečaka po sesiji, približno 12 s, najviše 40 ukupno. Snimci mogu sadržati i glasove ljudi pored tebe. Uz saglasnost osoba u prostoriji."
                android:textColor="@color/text_secondary" />
            <TextView android:id="@+id/recordingDescription" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="Snimanje zvuka nije uključeno."
                android:textSize="12sp" android:textColor="@color/warning" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="PROVERA PRE SPAVANJA" android:letterSpacing="0.10"
            android:fontFamily="sans-serif-medium" android:textSize="12sp" android:textColor="@color/text_secondary" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="9dp" android:background="@drawable/bg_card" android:padding="18dp"
            android:orientation="vertical">
            <Button android:id="@+id/readinessButton" android:layout_width="match_parent"
                android:layout_height="50dp" android:text="Proveri spremnost" android:textAllCaps="false"
                android:textColor="@color/button_text" android:background="@drawable/bg_primary" />
            <TextView android:id="@+id/readinessStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:text="Proveri dozvole i režim štednje baterije pre spavanja."
                android:textSize="13sp" android:textColor="@color/text_secondary" />
            <Button android:id="@+id/appSettingsButton" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:text="Dozvole i obaveštenja" android:textAllCaps="false"
                android:textColor="@color/text_primary" android:background="@drawable/bg_secondary" />
            <Button android:id="@+id/batterySettingsButton" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="Podešavanja baterije" android:textAllCaps="false"
                android:textColor="@color/text_primary" android:background="@drawable/bg_secondary" />
        </LinearLayout>

        <Button android:id="@+id/testButton" android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="14dp" android:text="Test obaveštenja → Huawei GT 2"
            android:textAllCaps="false" android:textStyle="bold" android:textColor="@color/text_primary"
            android:background="@drawable/bg_secondary" />

        <Button android:id="@+id/testBurstButton" android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="8dp" android:text="Test jačeg alarma ×3 (32 sekunde)"
            android:textAllCaps="false" android:textStyle="bold" android:textColor="@color/text_primary"
            android:background="@drawable/bg_secondary" />
        <TextView android:id="@+id/testBurstStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="7dp"
            android:text="Test ×3 (0/16/32 s) radi i tokom dana. Ostavi aplikaciju otvorenu."
            android:textColor="@color/text_secondary" android:textSize="12sp" />
        <Button android:id="@+id/snoreTestButton" android:layout_width="match_parent"
            android:layout_height="54dp" android:layout_marginTop="14dp"
            android:text="Testiraj prepoznavanje hrkanja (90 s)"
            android:textAllCaps="false" android:textStyle="bold"
            android:textColor="@color/button_text" android:background="@drawable/bg_primary" />
        <TextView android:id="@+id/snoreTestStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="Test mikrofona i AI hrkanja radi u bilo koje doba dana. Ne čuva snimke ni noćnu istoriju."
            android:textSize="12sp" android:textColor="@color/text_secondary" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="26dp" android:text="OVO PRAĆENJE" android:letterSpacing="0.10"
            android:fontFamily="sans-serif-medium" android:textSize="12sp" android:textColor="@color/text_secondary" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="9dp" android:background="@drawable/bg_card" android:padding="18dp"
            android:orientation="vertical">
            <TextView android:id="@+id/sessionTime" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Nema aktivnog praćenja" android:textColor="@color/text_secondary" android:textSize="13sp" />
            <TextView android:id="@+id/episodeStats" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Epizode hrkanja: 0" android:layout_marginTop="10dp"
                android:textColor="@color/text_primary" android:textSize="16sp" />
            <TextView android:id="@+id/snoreStats" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Procenjeno hrkanje: 0 min" android:layout_marginTop="8dp"
                android:textColor="@color/text_primary" android:textSize="16sp" />
            <TextView android:id="@+id/alertStats" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Serije alarma: 0 • Obaveštenja: 0" android:layout_marginTop="8dp"
                android:textColor="@color/text_primary" android:textSize="16sp" />
        </LinearLayout>

        <TextView android:id="@+id/diagnosticsText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="13dp"
            android:text="Dijagnostika će biti prikazana tokom praćenja."
            android:textColor="@color/text_secondary" android:textSize="12sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="26dp" android:text="EXPORT I IMPORT STATISTIKE" android:letterSpacing="0.10"
            android:fontFamily="sans-serif-medium" android:textSize="12sp" android:textColor="@color/text_secondary" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="9dp" android:background="@drawable/bg_card" android:padding="16dp"
            android:orientation="vertical">
            <Button android:id="@+id/backupButton" android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Export statistike (JSON za čuvanje)" android:textAllCaps="false"
                android:textColor="@color/text_primary" android:background="@drawable/bg_secondary" />
            <Button android:id="@+id/restoreButton" android:layout_width="match_parent"
                android:layout_height="50dp" android:layout_marginTop="9dp"
                android:text="Import statistike (JSON)" android:textAllCaps="false"
                android:textColor="@color/text_primary" android:background="@drawable/bg_secondary" />
            <Button android:id="@+id/exportCsvButton" android:layout_width="match_parent"
                android:layout_height="50dp" android:layout_marginTop="9dp" android:text="Export statistike (CSV za Excel)"
                android:textAllCaps="false" android:textColor="@color/text_primary"
                android:background="@drawable/bg_secondary" />
            <TextView android:id="@+id/exportStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:text="Za vraćanje podataka koristi JSON: čuva do 365 završenih noći i podešavanja. CSV služi samo za Excel i ne može se importovati. WAV snimci nisu deo izvoza. Sačuvaj JSON pre reinstalacije aplikacije."
                android:textColor="@color/text_secondary" android:textSize="12sp" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="26dp" android:text="HRKANJE PO SATIMA" android:letterSpacing="0.10"
            android:fontFamily="sans-serif-medium" android:textSize="12sp" android:textColor="@color/text_secondary" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="9dp" android:background="@drawable/bg_card" android:padding="16dp"
            android:orientation="vertical">
            <TextView android:id="@+id/hourlyDetails" android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Satna statistika dostupna nakon nove sesije."
                android:textColor="@color/text_secondary" android:textSize="13sp" />
            <rs.snoreguard.mvp.SnoreBarChartView android:id="@+id/hourlyChart"
                android:layout_width="match_parent" android:layout_height="190dp"
                android:layout_marginTop="10dp"
                android:contentDescription="Grafikon hrkanja od 22 do 08 časova" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="26dp" android:text="POREĐENJE PRETHODNIH NOĆI" android:letterSpacing="0.10"
            android:fontFamily="sans-serif-medium" android:textSize="12sp" android:textColor="@color/text_secondary" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="9dp" android:background="@drawable/bg_card" android:padding="16dp"
            android:orientation="vertical">
            <TextView android:id="@+id/comparisonDetails" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Još nema dovoljno podataka za poređenje."
                android:textColor="@color/text_secondary" android:textSize="13sp" />
            <rs.snoreguard.mvp.SnoreBarChartView android:id="@+id/comparisonChart"
                android:layout_width="match_parent" android:layout_height="190dp"
                android:layout_marginTop="10dp"
                android:contentDescription="Grafikon prepoznatih hrkanja tokom poslednjih sedam noći" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="26dp" android:text="ZVUČNI SNIMCI ZA LEKARA"
            android:letterSpacing="0.10" android:fontFamily="sans-serif-medium"
            android:textSize="12sp" android:textColor="@color/text_secondary" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="9dp" android:background="@drawable/bg_card"
            android:padding="16dp" android:orientation="vertical">
            <TextView android:id="@+id/clipCountText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Nema sačuvanih snimaka."
                android:textSize="13sp" android:textColor="@color/text_secondary" />
            <LinearLayout android:id="@+id/clipList" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:layout_marginTop="8dp" />
            <Button android:id="@+id/deleteAllClipsButton" android:layout_width="match_parent"
                android:layout_height="50dp" android:layout_marginTop="12dp"
                android:text="Obriši sve zvučne snimke" android:textAllCaps="false"
                android:textColor="@color/text_primary" android:background="@drawable/bg_secondary" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:textSize="12sp"
                android:text="Dodirni snimak da ga poslušaš, podeliš kao WAV ili obrišeš. Snimanje ne dijagnostikuje apneju."
                android:textColor="@color/text_secondary" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="26dp" android:text="PRETHODNE NOĆI" android:letterSpacing="0.10"
            android:fontFamily="sans-serif-medium" android:textSize="12sp" android:textColor="@color/text_secondary" />
        <TextView android:id="@+id/historyText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="9dp" android:background="@drawable/bg_card" android:padding="18dp"
            android:text="Još nema sačuvanih sesija." android:textColor="@color/text_secondary" android:textSize="14sp" />
        <TextView android:id="@+id/errorText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="" android:textColor="@color/warning" android:textSize="13sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="MVP • Nije medicinski uređaj niti test za apneju. Vibraciju sata treba proveriti tokom stvarnog sna."
            android:textColor="@color/text_secondary" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
